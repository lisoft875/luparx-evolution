# --- Java / Maven (backend/) -----------------------------------------------
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/wrapper/maven-wrapper.properties.bak
hs_err_pid*.log
replay_pid*.log

# --- Node / npm workspaces (frontend/) --------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnp/
.pnp.js
coverage/

# --- Vite ---------------------------------------------------------------
dist/
dist-ssr/
*.local
.vite/

# --- Capacitor (ios/android build output) -----------------------------------
frontend/apps/*/ios/App/Pods/
frontend/apps/*/ios/App/build/
frontend/apps/*/ios/DerivedData/
frontend/apps/*/android/.gradle/
frontend/apps/*/android/app/build/
frontend/apps/*/android/build/
frontend/apps/*/android/local.properties
frontend/apps/*/android/captures/
frontend/apps/*/ios/App/App/public/
# El equivalente en Android: `cap sync` copia acá el build web (dist/) en cada compilación. Es
# artefacto derivado, no fuente — versionarlo duplicaría el bundle entero en cada commit.
frontend/apps/*/android/app/src/main/assets/public/
*.ipa
*.apk
*.aab

# --- Entornos / secretos -----------------------------------------------------
.env
.env.*
!.env.example
!infra/.env.example
!infra/.env.deploy.example
# Defaults de desarrollo local sin secretos (puertos y flags): se versionan a proposito.
!.env.development
infra/.env
infra/secrets/
# Llaves de firma y respaldos del despliegue: se generan EN el servidor y no salen de ahí.
infra/secrets/deploy/
infra/backups/*
!infra/backups/.gitkeep

# Evidencia y documentos que el backend escribe al correr en la laptop (EVIDENCE_ROOT por omisión).
# Son datos de ejecución, no fuente: en el servidor viven en un volumen de Docker.
backend/app/data/

# Salidas de sesiones de Claude, que no son parte del producto.
Claude outputs/

# --- IDEs ---------------------------------------------------------------
.idea/
*.iml
.vscode/
!.vscode/extensions.json
.DS_Store
Thumbs.db

# --- Logs / temporales -------------------------------------------------------
*.log
logs/
tmp/
*.tmp

# Secretos de desarrollo generados por scripts/dev-setup.sh
infra/secrets/

# Capturas de los arneses responsive (evidencia local, no versionada)
frontend/tests/responsive/capturas/
