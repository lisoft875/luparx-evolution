<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>cr.luparx</groupId>
    <artifactId>luparx-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>luparx-app</artifactId>
  <name>luparx-app</name>
  <description>Spring Boot bootstrap: security, REST controllers, Flyway, OpenAPI, observability.</description>

  <properties>
    <!-- Por defecto el build EXCLUYE las pruebas de integracion (Testcontainers/Docker): corren
         aparte con el perfil `integration`, para que una maquina o un CI sin Docker no de un falso
         verde saltandolas. El perfil de abajo vacia este patron para incluirlas. -->
    <it.exclude>**/*IntegrationTest.java</it.exclude>
  </properties>

  <dependencies>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-platform-core</artifactId>
    </dependency>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-module-geo</artifactId>
    </dependency>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-module-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-module-tenancy</artifactId>
    </dependency>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-module-parking</artifactId>
    </dependency>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-module-enforcement</artifactId>
    </dependency>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-module-billing</artifactId>
    </dependency>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-module-notifications</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Testcontainers, para probar contra PostgreSQL de verdad (19-10-2026).

      Sin version: spring-boot-starter-parent 3.3.4 ya importa el BOM de Testcontainers, asi que la
      version la decide Spring Boot y no hay dos criterios que mantener sincronizados.

      Solo en `app`: es el unico modulo que tiene las migraciones de Flyway y el contexto completo.
      Las pruebas que necesitan Docker (WalletChargeIntegrationTest) estan EXCLUIDAS del build por
      defecto (ver <properties> `it.exclude` y el perfil `integration` abajo) y corren aparte con
      `mvn -Pintegration test`; asi el backend se compila y prueba en una maquina sin Docker, pero
      sin dar un falso verde: cuando se pide integracion y no hay Docker, el build FALLA.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        docker-java (el que arrastra Testcontainers) negocia la API de Docker en 1.32, y Docker
        Desktop exige mínimo 1.40 -> el preflight /info falla con 400 y las 9 pruebas de
        WalletChargeIntegrationTest se saltaban. La variable de entorno DOCKER_API_VERSION se
        ignora; la API se fija de verdad con esta propiedad de sistema en el JVM que forkea
        Surefire. El socket, por ser especifico de la maquina, vive en el
        ~/.testcontainers.properties del desarrollador, no aqui.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <api.version>1.44</api.version>
          </systemPropertyVariables>
          <excludes>
            <exclude>${it.exclude}</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- Contrapeso del skip por defecto del POM padre: este es el unico modulo ejecutable. -->
          <skip>false</skip>
          <mainClass>cr.luparx.app.LuparxApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Pruebas de integracion contra Docker real. `mvn -Pintegration test` las INCLUYE (vacia
      it.exclude) y, como WalletChargeIntegrationTest ya no se salta sin Docker, el build FALLA si
      el demonio no esta, en vez de reportar exito con pruebas criticas omitidas. Requisitos del
      entorno: Docker en marcha + ~/.testcontainers.properties con docker.host apuntando al socket
      del engine de la maquina (especifico de cada equipo, por eso no vive en el repo).
    -->
    <profile>
      <id>integration</id>
      <properties>
        <it.exclude>**/__no-excluir-nada__.java</it.exclude>
      </properties>
    </profile>
  </profiles>
</project>
