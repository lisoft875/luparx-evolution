<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>cr.luparx</groupId>
    <artifactId>luparx-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>luparx-app</artifactId>
  <name>luparx-app</name>
  <description>Spring Boot bootstrap: security, REST controllers, Flyway, OpenAPI, observability.</description>

  <dependencies>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-platform-core</artifactId>
    </dependency>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-module-geo</artifactId>
    </dependency>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-module-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-module-tenancy</artifactId>
    </dependency>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-module-parking</artifactId>
    </dependency>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-module-enforcement</artifactId>
    </dependency>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-module-billing</artifactId>
    </dependency>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-module-notifications</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- Contrapeso del skip por defecto del POM padre: este es el unico modulo ejecutable. -->
          <skip>false</skip>
          <mainClass>cr.luparx.app.LuparxApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
