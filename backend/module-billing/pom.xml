<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>cr.luparx</groupId>
    <artifactId>luparx-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>luparx-module-billing</artifactId>
  <name>luparx-module-billing</name>
  <description>Payments received, provider settlements and the reconciliation between the two.</description>

  <dependencies>
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-platform-core</artifactId>
    </dependency>
    <!--
      Tenancy, because every peso belongs to a municipality and its currency is read from it.

      Deliberately NOT module-parking, even though today every payment credits a parking wallet.
      Money coming in is a different question from what it is later spent on: fines will be paid
      here too, and a permit, and whatever a municipality sells next. A module that depended on
      parking would have to be rewritten the first time something other than parking took money —
      and it would make "what did the municipality collect" a question only the parking module could
      answer. What this module knows about the wallet is one identifier it was handed.
    -->
    <dependency>
      <groupId>cr.luparx</groupId>
      <artifactId>luparx-module-tenancy</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
  </dependencies>
</project>
