<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    LupaRX backend — modular monolith (docs/ARCHITECTURE.md §1, ADR 0001).
    Module dependency rule (no cycles, enforced by the POMs below):
      platform-core  -> (nothing)
      module-geo     -> platform-core
      module-identity-> platform-core, module-geo
      module-tenancy -> platform-core
      module-parking -> platform-core, module-tenancy
      app            -> every module
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>cr.luparx</groupId>
  <artifactId>luparx-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>luparx-backend</name>
  <description>LupaRX municipal parking enforcement platform — backend</description>

  <modules>
    <module>platform-core</module>
    <module>module-geo</module>
    <module>module-identity</module>
    <module>module-tenancy</module>
    <module>module-parking</module>
    <module>app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <libphonenumber.version>8.13.42</libphonenumber.version>
    <springdoc.version>2.6.0</springdoc.version>
    <bouncycastle.version>1.78.1</bouncycastle.version>
    <commons-codec.version>1.17.1</commons-codec.version>
    <!--
      Spring Boot 3.3 no gestiona com.nimbusds:nimbus-jose-jwt: llega transitivamente a traves de
      spring-security-oauth2-jose, pero module-identity lo usa de forma directa para emitir y rotar
      las llaves RS256, asi que la version se declara aqui. Es la misma que trae Spring Security 6.3,
      para que no haya dos versiones en el classpath.
    -->
    <nimbus-jose-jwt.version>9.37.3</nimbus-jose-jwt.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>cr.luparx</groupId>
        <artifactId>luparx-platform-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cr.luparx</groupId>
        <artifactId>luparx-module-geo</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cr.luparx</groupId>
        <artifactId>luparx-module-identity</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cr.luparx</groupId>
        <artifactId>luparx-module-tenancy</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cr.luparx</groupId>
        <artifactId>luparx-module-parking</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>com.googlecode.libphonenumber</groupId>
        <artifactId>libphonenumber</artifactId>
        <version>${libphonenumber.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nimbusds</groupId>
        <artifactId>nimbus-jose-jwt</artifactId>
        <version>${nimbus-jose-jwt.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <parameters>true</parameters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
