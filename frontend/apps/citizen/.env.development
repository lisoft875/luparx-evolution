# Valores de desarrollo local (sin secretos) — ver docs/PORTS.md.
# Sobrescribí cualquiera de estos en un .env local, que no se versiona.
VITE_API_BASE_URL=http://localhost:8090
VITE_PORTAL=citizen
# Poné true para correr la app sin backend, contra el transporte simulado.
VITE_USE_MOCKS=false

# Proveedor de teselas del mapa de zonas. SOLO DESARROLLO Y PRUEBAS.
# No está en `.env`, así que una compilación de producción no pide teselas a nadie: sin esta
# variable el mapa no se dibuja y lo dice. Antes de producción hay que revisar licencia,
# atribución, CSP, disponibilidad y condiciones de uso del proveedor que se elija.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
