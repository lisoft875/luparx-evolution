# Base URL of the LupaRX API (CONTRACT.md §4). No trailing slash.
# Local development points at the backend on its non-default port (see docs/PORTS.md).
VITE_API_BASE_URL=http://localhost:8090

# Portal this app authenticates against — must stay "platform" (CONTRACT.md §0).
# There is no self-registration for this portal: accounts are created from
# inside the back-office itself by another PLATFORM_ADMIN.
VITE_PORTAL=platform

# When "true", the app runs entirely against the built-in mock transport
# (@luparx/api-client/mocks) — no backend required. See frontend/README.md.
VITE_USE_MOCKS=true
