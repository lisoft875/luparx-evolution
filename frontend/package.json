{
  "name": "luparx-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "LupaRX frontend monorepo: multi-portal municipal fiscalization platform (npm workspaces).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@luparx/citizen --workspace=@luparx/inspector --workspace=@luparx/admin --workspace=@luparx/platform",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "dev:citizen": "npm run dev --workspace=@luparx/citizen",
    "dev:inspector": "npm run dev --workspace=@luparx/inspector",
    "dev:admin": "npm run dev --workspace=@luparx/admin",
    "dev:platform": "npm run dev --workspace=@luparx/platform",
    "demo:citizen": "npm run preview:demo --workspace=@luparx/citizen",
    "demo:admin": "npm run preview:demo --workspace=@luparx/admin",
    "demo:inspector": "npm run preview:demo --workspace=@luparx/inspector",
    "demo:platform": "npm run preview:demo --workspace=@luparx/platform"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.6.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
