# =================================================================================================
# Variables del despliegue. Copiá este archivo a infra/.env EN EL SERVIDOR y llenalo ahí.
#
#   cp infra/.env.deploy.example infra/.env && chmod 600 infra/.env
#
# infra/.env NO se versiona y no debe salir del servidor. Nada acá tiene un valor por omisión
# utilizable a propósito: una contraseña de ejemplo que funciona es una contraseña que sobrevive
# hasta producción.
# =================================================================================================

# --- qué ambiente es este -------------------------------------------------------------------------
# Prefija contenedores, redes y volúmenes: es lo que permite que staging y producción convivan en la
# misma instancia sin pisarse, y que ninguno choque con otro sitio que ya viva en la máquina.
COMPOSE_PROJECT_NAME=luparx-staging
# Se ve en /actuator/info. Poner el nombre real: staging, production…
LUPARX_ENVIRONMENT=staging

# --- identidad pública de la instancia ---------------------------------------------------------
# Dominio con el que la gente entra, incluido el esquema y SIN barra final. Es el origen con el que
# se compilan los portales y el que valida CORS, así que cambiarlo obliga a reconstruir.
PUBLIC_BASE_URL=https://staging.tu-dominio.com
# Sólo el host, sin esquema. Lo usa el Caddy opcional (--profile edge) para pedir el certificado.
PUBLIC_HOST=staging.tu-dominio.com
ACME_EMAIL=vos@tu-dominio.com

# --- base de datos -------------------------------------------------------------------------------
POSTGRES_DB=luparx
POSTGRES_USER=luparx
# Generala: openssl rand -base64 32
POSTGRES_PASSWORD=
# Fijá una etiqueta que exista para la arquitectura de la instancia. En Lightsail x86_64 sirve la de
# abajo; en una instancia ARM revisá qué versiones publica postgis para arm64.
POSTGRES_IMAGE=postgis/postgis:16-3.4

# --- firma de tokens -----------------------------------------------------------------------------
# El par de llaves se genera con scripts/gen-jwt-keys.sh y queda en infra/secrets/deploy/.
# El identificador viaja en cada token y sirve para rotar sin invalidar los emitidos.
JWT_KEY_ID=deploy-2026-09
# Pimienta del hash de IP del limitador de intentos. Generala: openssl rand -hex 32
IP_HASH_PEPPER=

# --- perfil y datos ------------------------------------------------------------------------------
# `demo`  = las cinco municipalidades de prueba, con la seguridad de un entorno real.
# vacío   = sólo el esquema; los datos se cargan desde el portal de plataforma.
# `dev`   = JAMÁS en un servidor: llaves efímeras y pepper del repositorio.
SPRING_PROFILES_ACTIVE=demo
LUPARX_DEV_SEED_DEMO_DATA=true

# --- correo ----------------------------------------------------------------------------------------
# Por omisión apunta al Mailpit del perfil `demo-mail`: los correos de verificación quedan visibles
# en su interfaz en vez de perderse. Para correo real, poné acá el proveedor y no levantes ese perfil.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS_ENABLED=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@tu-dominio.com

# --- quién termina el TLS ----------------------------------------------------------------------------
# Perfiles opcionales de compose, separados por coma. Compose lee esta variable por su cuenta.
#
#   edge        Caddy toma los puertos 80/443 y saca y renueva el certificado solo. Es lo correcto en
#               una INSTANCIA DEDICADA, donde no hay ningún otro proxy. Requiere que el DNS del
#               dominio ya apunte a esta instancia ANTES de levantar: Let's Encrypt verifica
#               conectándose, y tres intentos fallidos consumen la cuota del dominio por una hora.
#   demo-mail   Mailpit: los correos de verificación quedan legibles en su interfaz en vez de
#               perderse. Para una demo sin SMTP real.
#
# Dejalo VACÍO si la instancia ya tiene nginx/Traefik sirviendo otros sitios: ahí el proxy que está
# reenvía a 127.0.0.1:$WEB_HTTP_PORT y este despliegue no debe pelear por los puertos.
COMPOSE_PROFILES=edge,demo-mail
# Emisor del certificado. VACÍO en el servidor = Let's Encrypt. Ponelo en `internal` sólo para
# probar en una máquina de desarrollo, donde no hay un dominio real que validar.
CADDY_TLS=""

# --- el sitio informativo (opcional) ----------------------------------------------------------------
# El sitio comercial/municipal (repositorio luparx-municipal-site), servido por el mismo Caddy en la
# RAÍZ del dominio. Son archivos estáticos: no necesita contenedor, base ni build.
#
# Dejá las tres vacías si esta instalación sólo publica la plataforma.
#
#   SITE_HOST      el dominio, sin esquema
#   SITE_HOST_WWW  la variante con www, que se redirige con 301 a la de arriba
#   SITE_ROOT      dónde está clonado EN EL SERVIDOR (es otro repositorio, con su propio ciclo)
SITE_HOST=luparx.com
SITE_HOST_WWW=www.luparx.com
SITE_ROOT=/home/ubuntu/luparx-municipal-site

# --- publicación local -----------------------------------------------------------------------------
# Puerto en el que este despliegue escucha DENTRO de la instancia. El proxy que ya tenga la máquina
# (nginx, Caddy, Traefik…) reenvía a 127.0.0.1:$WEB_HTTP_PORT. Cambiá el puerto si 8093 está tomado.
WEB_BIND_ADDRESS=127.0.0.1
# Si mañana se agrega producción en la misma máquina, va en otro puerto (8094, por ejemplo).
WEB_HTTP_PORT=8093
MAILPIT_BIND_ADDRESS=127.0.0.1
MAILPIT_UI_PORT=8035

# --- valores por omisión de esta instalación ---------------------------------------------------------
# Son los que rellenan lo que una municipalidad todavía no configuró. No son una afirmación sobre el
# único mercado que se atiende.
PLATFORM_DEFAULT_COUNTRY_CODE=CR
PLATFORM_DEFAULT_CURRENCY_CODE=CRC
PLATFORM_DEFAULT_LOCALE=es-CR
PLATFORM_DEFAULT_TIME_ZONE=America/Costa_Rica

# --- runtime ------------------------------------------------------------------------------------
# Etiqueta de las imágenes construidas. scripts/deploy.sh la pone al hash del commit desplegado.
LUPARX_VERSION=local
JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError
