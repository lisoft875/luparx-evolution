# Copiar a infra/.env para desarrollo local: `cp infra/.env.example infra/.env`.
# NINGÚN valor aquí es un secreto real. En cualquier entorno compartido o de producción, estos
# valores deben venir del gestor de secretos del entorno de despliegue, nunca de este archivo.

# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL 16 — infra/docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_DB=luparx
POSTGRES_USER=luparx
POSTGRES_PASSWORD=luparx_dev_only
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# URL JDBC usada por el backend (Spring Boot)
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# ---------------------------------------------------------------------------
# JWT (ADR 0005) — RS256 con JWKS público
# ---------------------------------------------------------------------------
# Rutas a un par de claves RSA generado localmente (nunca commitear las claves reales).
# Generar con: openssl genrsa -out jwt-private-dev.pem 2048
#              openssl rsa -in jwt-private-dev.pem -pubout -out jwt-public-dev.pem
JWT_PRIVATE_KEY_PATH=./infra/secrets/jwt-private-dev.pem
JWT_PUBLIC_KEY_PATH=./infra/secrets/jwt-public-dev.pem
JWT_KEY_ID=dev-key-1
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Clave de cifrado en reposo del secreto TOTP (SECURITY.md §11). Generar una nueva por entorno,
# nunca reutilizar el valor de ejemplo. Ejemplo: openssl rand -base64 32
MFA_TOTP_ENCRYPTION_KEY=dev_only_change_me_base64_32_bytes

# ---------------------------------------------------------------------------
# Federación de identidad (ADR 0006) — credenciales de cliente OAuth por proveedor
# ---------------------------------------------------------------------------
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

OAUTH_MICROSOFT_TENANT_ID=common
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=

# URL base pública del backend, usada para construir los redirect_uri de callback OAuth
OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# SMTP (Mailpit en desarrollo — infra/docker-compose.yml)
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@luparx.local
SMTP_STARTTLS_ENABLED=false
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# Adminer (opcional, perfil "tools" de docker-compose)
# ---------------------------------------------------------------------------
ADMINER_PORT=8081

# ---------------------------------------------------------------------------
# Defaults de plataforma (ADR 0008 — SÓLO configuración, nunca supuestos de código)
# Estos valores sólo semillan el primer país/tenant de ejemplo en desarrollo local.
# ---------------------------------------------------------------------------
PLATFORM_DEFAULT_COUNTRY_CODE=CR
PLATFORM_DEFAULT_CURRENCY_CODE=CRC
PLATFORM_DEFAULT_LOCALE=es-CR
PLATFORM_DEFAULT_TIME_ZONE=America/Costa_Rica
PLATFORM_DEFAULT_DIAL_CODE=+506

# ---------------------------------------------------------------------------
# Backend (Spring Boot)
# ---------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# ---------------------------------------------------------------------------
# Frontend (Vite) — orígenes CORS por portal (SECURITY.md §7)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGIN_CITIZEN=http://localhost:5173
CORS_ALLOWED_ORIGIN_ADMIN=http://localhost:5174
CORS_ALLOWED_ORIGIN_INSPECTOR=http://localhost:5175
