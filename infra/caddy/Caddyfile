# TLS automático para la instancia, sólo si no hay ya un proxy sirviendo 80/443.
# Se activa poniendo COMPOSE_PROFILES=edge en infra/.env (ver docs/DEPLOYMENT.md §3).
{
	email {$ACME_EMAIL}
}

{$PUBLIC_HOST} {
	# De dónde sale el certificado.
	#
	# En el SERVIDOR la variable va VACÍA: Caddy usa Let's Encrypt, que es lo que se quiere, y esta
	# línea se evapora. En la MÁQUINA DE DESARROLLO se pone CADDY_TLS=internal (ver infra/.env.local)
	# y Caddy firma un certificado propio — así se ejercita EXACTAMENTE esta configuración, los
	# mismos encabezados y el mismo reverse_proxy, sin pedir uno para "localhost", que Let's Encrypt
	# no puede emitir y cuyos intentos fallidos gastan cuota del dominio.
	#
	# Va como directiva del SITIO y no como opción global: `tls internal` sólo existe acá dentro
	# (`ca` y `acme_ca` a nivel global son otra cosa — `acme_ca` sólo acepta URLs ACME, y el emisor
	# interno no lo es). Y como `tls` a secas es un error de sintaxis, la variable trae la palabra
	# `tls` incluida: vacía, no queda ninguna línea.
	{$CADDY_TLS}

	encode zstd gzip

	# HSTS: una vez que el dominio sirve HTTPS, el navegador deja de intentar HTTP.
	#
	# SIN `includeSubDomains`, y es deliberado. Esto suele servir un subdominio (staging.luparx.com);
	# con esa directiva, el navegador de cualquiera que entre acá pasaría a exigir HTTPS en TODO
	# luparx.com —incluidos subdominios que quizá todavía no tengan certificado—, y el efecto dura
	# un año en el equipo de cada visitante aunque se corrija el servidor. Una instalación que sirva
	# el dominio raíz y controle todos sus subdominios puede añadirla.
	#
	# Un mes y no un año: mientras esto sea una demo, un error de certificado tiene que poder
	# corregirse sin dejar a nadie fuera durante doce meses.
	header Strict-Transport-Security "max-age=2592000"

	# Los documentos de respaldo de un permiso llegan hasta 20 MB (luparx.enforcement
	# .max-document-bytes). Sin esto, Caddy corta la subida antes de que el backend pueda contestar
	# el error del contrato, y el ciudadano ve un fallo crudo en vez de un mensaje.
	request_body {
		max_size 24MB
	}

	reverse_proxy web:80
}

# =================================================================================================
# El sitio informativo (repositorio luparx-municipal-site), en la RAÍZ del dominio.
#
# Va en este mismo Caddy y no en un contenedor propio porque son cuatro archivos estáticos: montar
# un nginx para servirlos sería más partes móviles que contenido. Caddy ya está acá, ya gestiona los
# certificados y sabe servir un directorio.
#
# SITE_HOST sin valor apunta a `localhost`: Caddy NO puede pedirle un certificado público a un
# nombre que no existe —lo intentaría, fallaría y reintentaría en bucle—, y `localhost` se resuelve
# con su emisor interno sin salir a la red. Una instalación que sólo quiera la plataforma deja las
# dos variables vacías y estos bloques quedan inertes.
# =================================================================================================
{$SITE_HOST:localhost} {
	{$CADDY_TLS}

	root * /srv/site
	file_server
	encode zstd gzip

	header {
		# Mismas cabeceras que los portales. Sin X-Robots-Tag: este sitio SÍ tiene que aparecer en
		# los buscadores — es su razón de existir.
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=2592000"
	}

	# El HTML no se cachea y los assets sí: una imagen de marca no cambia, la página puede cambiar
	# hoy y tiene que verse hoy.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=604800"
	@html path *.html /
	header @html Cache-Control "no-cache"
}

# `www` al dominio sin www, con 301 permanente: dos direcciones que sirven lo mismo dividen el
# posicionamiento y hacen que un enlace compartido no coincida con el otro.
{$SITE_HOST_WWW:localhost:8443} {
	{$CADDY_TLS}
	redir https://{$SITE_HOST}{uri} permanent
}
